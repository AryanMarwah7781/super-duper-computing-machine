# Addresses. Change these, restart the app, done. No code to edit.
#
# There are TWO different machines here and they are easy to mix up:

# 1. The SiMa devkit. Answers questions from the operator's manual.
ASSIST_DEVKIT_URL=http://192.168.94.180:8090

# 2. The simulator. Receives spoken ORDERS -- "fold the boom", "start
#    spraying". Nothing to do with the manual. This is the machine whose IP
#    changes when you move the demo.
ASSIST_TRIGGER_URL=http://192.168.94.40:5000/trigger

# 3. Chris, the conversational model. llama.cpp on the board, CPU only.
#    Greetings go here; machine questions go to the devkit above.
ASSIST_LLM_URL=http://192.168.94.180:8091/v1/chat/completions

# Optional.
# ASSIST_TIMEOUT_S=300     how long to wait for the board
# ASSIST_TRIGGER_TIMEOUT_S=5
# ASSIST_WAKE_THRESHOLD=0.6
